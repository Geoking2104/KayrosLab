PORT=8787
ALLOWED_ORIGIN=https://www.kayroslab.com
# Anthropic (cle serveur, jamais exposee au client)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MAXTOK=1024
# Ollama (si joignable depuis ce serveur)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
# Secret partage optionnel (si defini, header X-Kayros-Secret requis)
KAYROS_SECRET=

# --- Authentification & portefeuille ---
# Secret de signature des jetons. OBLIGATOIRE pour activer /v1/auth/* et /v1/ideas /v1/portfolio.
# S'il est absent, ces routes repondent 503 (desactivees) : elles ne sont JAMAIS ouvertes sans secret.
# Generer une valeur longue et aleatoire, ex. : openssl rand -base64 48
KAYROS_AUTH_SECRET=
