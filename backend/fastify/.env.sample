PORT=8787
ALLOWED_ORIGIN=https://www.kayroslab.com
# Anthropic (cle serveur, jamais exposee au client)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MAXTOK=1024
# Ollama (si joignable depuis ce serveur)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
# Secret partage optionnel (si defini, header X-Kayros-Secret requis)
KAYROS_SECRET=

# --- Authentification & portefeuille ---
# Secret de signature des jetons. OBLIGATOIRE pour activer /v1/auth/* et /v1/ideas /v1/portfolio.
# S'il est absent, ces routes repondent 503 (desactivees) : elles ne sont JAMAIS ouvertes sans secret.
# Generer une valeur longue et aleatoire, ex. : openssl rand -base64 48
KAYROS_AUTH_SECRET=

# Persistance sur disque. Si non defini, les donnees vivent en memoire et sont
# PERDUES au redemarrage (le serveur l'annonce au demarrage pour les comptes).
# Fichiers ecrits en 0600 (proprietaire seul) : ils contiennent des empreintes de mots de passe.
KAYROS_USERS_FILE=/opt/kayroslab/data/users.json
KAYROS_IDEAS_FILE=/opt/kayroslab/data/ideas.json

# --- Notifications de gouvernance ---
# Sans au moins un canal externe, un censeur hors de l'application n'est PAS prevenu
# qu'un gate l'attend (le serveur l'annonce au demarrage).
# Webhook : Slack / Teams / n8n / Zapier — le plus simple a mettre en place.
KAYROS_NOTIFY_WEBHOOK=
# Email (optionnel) : necessite `npm i nodemailer`. Format URL SMTP.
KAYROS_SMTP_URL=
KAYROS_MAIL_FROM=kayroslab@votre-domaine.fr

# File d'arbitrage. Sans ce fichier, les gates en cours sont perdus au redemarrage
# (alors que comptes et idees survivent) : le serveur l'annonce au demarrage.
KAYROS_GATES_FILE=/opt/kayroslab/data/gates.json
