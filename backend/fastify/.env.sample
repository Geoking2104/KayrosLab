# KayrosLab backend — copy to .env and fill secrets

PORT=8787
HOST=0.0.0.0
ALLOWED_ORIGIN=https://www.kayroslab.com

KAYROS_SECRET=
KAYROS_AUTH_SECRET=

# Developer Portal MCP (Streamable HTTP at /mcp).
# Generate a raw token + SHA-256 client entry with:
# node ../../scripts/generate-mcp-token.mjs --client-id codex --tenant-id my-tenant
# Store only the JSON client entries on the server; raw tokens stay in each tool's secret store.
KAYROS_MCP_CLIENTS_JSON=[]
KAYROS_MCP_ALLOWED_ORIGINS=
KAYROS_MCP_RATE_LIMIT=60

# LLM
MISTRAL_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434
EMBED_MODEL=nomic-embed-text
KAYROS_EMBED_MODEL=

# Authorized stakeholder profile imports (optional, server-side only).
# LinkedIn's standard Profile API imports only the authenticated member.
# Crystal Profile API supports lookup by LinkedIn URL/email on eligible plans.
LINKEDIN_ACCESS_TOKEN=
CRYSTALKNOWS_API_TOKEN=

# Sales Oracle document uploads (S3-compatible: AWS, MinIO, OVH Object Storage).
# Keep these values server-side. The API only returns short-lived signed upload URLs.
KAYROS_S3_BUCKET=
KAYROS_S3_REGION=gra
KAYROS_S3_ENDPOINT=
KAYROS_S3_ACCESS_KEY_ID=
KAYROS_S3_SECRET_ACCESS_KEY=
KAYROS_S3_FORCE_PATH_STYLE=false
KAYROS_S3_UPLOAD_TTL_SECONDS=900

# Postgres. Sur le VPS, deploy/ovh-vps/setup-postgres-local.sh provisionne une
# base locale et renseigne cette ligne lui-meme : le mot de passe est genere sur
# la machine et ne circule nulle part. Ne la remplir a la main que pour pointer
# vers une base distante — dans ce cas le provisionnement local s'abstient.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/kayroslab
# En production multi-instance, interdit le fallback vers la memoire si la base
# n'est pas joignable. Toutes les instances doivent pointer vers la meme base.
KAYROS_REQUIRE_POSTGRES=false
KAYROS_PG_POOL_MAX=10
# Duree du claim d'un webhook avant reprise par une autre instance apres crash.
KAYROS_COLLAB_MESSAGE_LEASE_SECONDS=300

# Persistence files (optional)
# KAYROS_USERS_FILE=./data/users.json
# KAYROS_IDEAS_FILE=./data/ideas.json
# KAYROS_AUDIT_FILE=./data/audit.ndjson   # historique persistant du cycle / gates (EF-32)
# KAYROS_AUDIT_RING=5000                  # taille du buffer en memoire recharge au demarrage

# Slack
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_GATE_CHANNEL=C0XXXXXXX

# Teams
# TEAMS_APP_ID=
# TEAMS_BOT_PASSWORD=
# TEAMS_WEBHOOK_URL=
# TEAMS_GATE_CHANNEL=

# Discord
# DISCORD_APPLICATION_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_PUBLIC_KEY=
# DISCORD_WEBHOOK_URL=
# DISCORD_GATE_CHANNEL=

# Runs suspendus sur un gate humain (reprise via /v1/runs/:runId/resume).
# Persistance fichier par defaut (./.kayros-runs.json) : un redemarrage ne perd
# pas les runs en attente de decision. Mettre `memory` pour un store volatil.
# Avec DATABASE_URL, les runs et les decisions sont partages dans Postgres.
KAYROS_RUNS_FILE=./data/runs.json

# Notifications de gouvernance (gates)
# KAYROS_GATES_FILE=./data/gates.json
# KAYROS_NOTIFY_WEBHOOK=
# KAYROS_SMTP_URL=
# KAYROS_MAIL_FROM=kayroslab@votre-domaine.fr
# KAYROS_REPORT_LEAD_BCC=

# Groupes de travail et seed de demonstration
# KAYROS_WG_FILE=./data/working-groups.json
# KAYROS_SEED_TENANT=default
# KAYROS_SEED_AUTHOR=

GOOGLE_API_KEY=
GOOGLE_CX=

# --- Search tools (web) ---
# Provider: auto | tavily | brave | google | duckduckgo
KAYROS_SEARCH_PROVIDER=auto
KAYROS_SEARCH_LIMIT=5
BRAVE_API_KEY=
TAVILY_API_KEY=

GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_BASE_URL=https://gitlab.com

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kayroslab
QDRANT_DIM=768
QDRANT_API_KEY=

# --- TimesFM 2.5 KPI forecasting (optional) ---
# Keep disabled until the isolated service is provisioned. On the OVH VPS,
# deploy-timesfm.sh exposes it only on 127.0.0.1:8001.
KAYROS_TIMESFM_ENABLED=false
KAYROS_TIMESFM_ENDPOINT=http://127.0.0.1:8001
KAYROS_TIMESFM_TOKEN=
KAYROS_TIMESFM_TIMEOUT_MS=30000
KAYROS_TIMESFM_CACHE_TTL_MS=900000
KAYROS_TIMESFM_CACHE_MAX=100
KAYROS_TIMESFM_MAX_BATCH=32
TIMESFM_MODEL_ID=google/timesfm-2.5-200m-pytorch
TIMESFM_MAX_CONTEXT=1024
TIMESFM_MAX_HORIZON=256
TIMESFM_TORCH_THREADS=2
