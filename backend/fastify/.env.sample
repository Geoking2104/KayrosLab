PORT=8787
ALLOWED_ORIGIN=https://www.kayroslab.com
# Anthropic (cle serveur, jamais exposee au client)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MAXTOK=1024
# Mistral (demo publique HTML — prioritaire si defini)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Ollama (si joignable depuis ce serveur)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
# Secret partage optionnel (si defini, header X-Kayros-Secret requis)
# Les routes /v1/demo/* restent publiques meme si ce secret est defini.
KAYROS_SECRET=

# --- Authentification & portefeuille ---
KAYROS_AUTH_SECRET=
KAYROS_USERS_FILE=/opt/kayroslab/data/users.json
KAYROS_IDEAS_FILE=/opt/kayroslab/data/ideas.json

# --- Notifications de gouvernance ---
KAYROS_NOTIFY_WEBHOOK=
KAYROS_SMTP_URL=
KAYROS_MAIL_FROM=kayroslab@votre-domaine.fr
KAYROS_REPORT_LEAD_BCC=geoffroydelatournelle@gmail.com
KAYROS_GATES_FILE=/opt/kayroslab/data/gates.json

# --- Positionnement concurrentiel ---
GOOGLE_API_KEY=
GOOGLE_CX=
GITHUB_TOKEN=

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kayroslab
QDRANT_DIM=768
QDRANT_API_KEY=
