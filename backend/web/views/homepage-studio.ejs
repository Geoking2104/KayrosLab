<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= __('site_title') %></title>
    <meta name="description" content="<%= __('studio_meta_description') %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=JetBrains+Mono:wght@500&family=Tomorrow:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="./tokens.css">
    <link rel="stylesheet" href="./studio.css">
</head>
<body>
    <a class="skip-link" href="#main"><%= __('studio_skip') %></a>

    <nav class="frame site-nav" aria-label="<%= __('studio_nav_label') %>">
        <a class="wordmark" href="/">KayrosLab</a>
        <div class="nav-actions">
            <div class="language-links" aria-label="<%= __('studio_language_label') %>">
                <a href="/" <%= locale === 'en' ? 'aria-current="page"' : '' %>>EN</a>
                <a href="/index.fr.html" <%= locale === 'fr' ? 'aria-current="page"' : '' %>>FR</a>
            </div>
            <a class="button button--primary nav-cta" href="/kayroslab-complete-with-ai-agents.html"><%= __('studio_nav_launch') %></a>
        </div>
    </nav>

    <main id="main">
        <header class="frame hero">
            <div class="hero-copy">
                <span class="eyebrow">[ <%= __('studio_badge') %> ]</span>
                <h1><%= __('studio_hero_title') %></h1>
                <p><%= __('studio_hero_copy') %></p>
                <div class="hero-actions">
                    <a class="button button--primary" href="/kayroslab-complete-with-ai-agents.html"><%= __('studio_hero_primary') %></a>
                    <a class="button" href="https://github.com/Geoking2104/KayrosLab"><%= __('studio_hero_secondary') %></a>
                </div>
                <p class="sovereign-line"><%= __('studio_sovereign') %></p>
            </div>

            <figure class="constellation" aria-label="<%= __('studio_constellation_aria') %>">
                <svg viewBox="0 0 560 520" role="img" aria-hidden="true">
                    <circle class="orbit" cx="280" cy="260" r="170"/>
                    <circle class="orbit" cx="280" cy="260" r="112"/>
                    <path class="link-line" d="M280 260L145 145M280 260L425 142M280 260L438 365M280 260L135 378"/>
                    <path class="link-line" d="M145 145L425 142M425 142L438 365M438 365L135 378M135 378L145 145"/>

                    <g transform="translate(280 260)">
                        <circle class="core-ring" r="63"/>
                        <circle class="core-dot" r="8"/>
                        <text class="core-title" text-anchor="middle" y="-19">KAYROSLAB</text>
                        <text class="node-role" text-anchor="middle" y="29"><%= __('studio_core') %></text>
                    </g>
                    <g transform="translate(145 145)">
                        <circle class="node-ring" r="46"/>
                        <circle class="node-dot" cx="0" cy="-18" r="4"/>
                        <text class="node-title" text-anchor="middle" y="4"><%= __('studio_agent_cfo') %></text>
                        <text class="node-role" text-anchor="middle" y="21"><%= __('studio_agent_cfo_role') %></text>
                    </g>
                    <g transform="translate(425 142)">
                        <circle class="node-ring" r="49"/>
                        <circle class="node-dot" cx="0" cy="-18" r="4"/>
                        <text class="node-title" text-anchor="middle" y="4"><%= __('studio_agent_product') %></text>
                        <text class="node-role" text-anchor="middle" y="21"><%= __('studio_agent_product_role') %></text>
                    </g>
                    <g transform="translate(438 365)">
                        <circle class="node-ring" r="48"/>
                        <circle class="node-dot" cx="0" cy="-18" r="4"/>
                        <text class="node-title" text-anchor="middle" y="4"><%= __('studio_agent_risk') %></text>
                        <text class="node-role" text-anchor="middle" y="21"><%= __('studio_agent_risk_role') %></text>
                    </g>
                    <g transform="translate(135 378)">
                        <circle class="node-ring" r="50"/>
                        <circle class="core-dot" cx="0" cy="-18" r="4"/>
                        <text class="node-title" text-anchor="middle" y="4"><%= __('studio_agent_timesfm') %></text>
                        <text class="node-role" text-anchor="middle" y="21"><%= __('studio_agent_timesfm_role') %></text>
                    </g>
                </svg>
            </figure>
        </header>

        <section class="section" aria-labelledby="problem-title">
            <div class="frame problem">
                <div>
                    <span class="eyebrow"><%= __('studio_problem_label') %></span>
                    <h2 id="problem-title"><%= __('studio_problem_title') %></h2>
                </div>
                <p class="section-copy"><%= __('studio_problem_copy') %></p>
            </div>
        </section>

        <section id="swarm" class="section" aria-labelledby="swarm-title">
            <div class="frame section-grid">
                <div class="section-head">
                    <span class="eyebrow"><%= __('studio_swarm_label') %></span>
                    <h2 id="swarm-title"><%= __('studio_swarm_title') %></h2>
                    <p class="section-copy"><%= __('studio_swarm_copy') %></p>
                </div>
                <ol class="pillar-list">
                    <li><span class="pillar-number">A</span><h3><%= __('studio_pillar_1_title') %></h3><p><%= __('studio_pillar_1_copy') %></p></li>
                    <li><span class="pillar-number">B</span><h3><%= __('studio_pillar_2_title') %></h3><p><%= __('studio_pillar_2_copy') %></p></li>
                    <li><span class="pillar-number">C</span><h3><%= __('studio_pillar_3_title') %></h3><p><%= __('studio_pillar_3_copy') %></p></li>
                </ol>
            </div>
        </section>

        <section id="workflow" class="section workflow" aria-labelledby="workflow-title">
            <div class="frame section-grid">
                <div class="section-head">
                    <span class="eyebrow"><%= __('studio_workflow_label') %></span>
                    <h2 id="workflow-title"><%= __('studio_workflow_title') %></h2>
                    <p class="section-copy"><%= __('studio_workflow_copy') %></p>
                </div>
                <ol class="step-list">
                    <li><div><h3><%= __('studio_step_1_title') %></h3><p><%= __('studio_step_1_copy') %></p></div></li>
                    <li><div><h3><%= __('studio_step_2_title') %></h3><p><%= __('studio_step_2_copy') %></p></div></li>
                    <li><div><h3><%= __('studio_step_3_title') %></h3><p><%= __('studio_step_3_copy') %></p></div></li>
                    <li><div><h3><%= __('studio_step_4_title') %></h3><p><%= __('studio_step_4_copy') %></p></div></li>
                </ol>
            </div>
        </section>

        <section id="timesfm" class="section" aria-labelledby="timesfm-title">
            <div class="frame">
                <div class="section-head">
                    <span class="eyebrow"><%= __('studio_timesfm_label') %></span>
                    <h2 id="timesfm-title"><%= __('studio_timesfm_title') %></h2>
                    <p class="section-copy"><%= __('studio_timesfm_copy') %></p>
                </div>
                <div class="forecast-layout">
                    <figure class="forecast-figure">
                        <figcaption class="forecast-label"><span><%= __('studio_simulation_label') %></span><span>T+36</span></figcaption>
                        <svg viewBox="0 0 760 360" role="img" aria-label="<%= __('studio_chart_aria') %>">
                            <path class="forecast-grid-line" d="M40 55H720M40 130H720M40 205H720M40 280H720"/>
                            <path class="forecast-divider" d="M348 35V310"/>
                            <path class="forecast-band" d="M348 186C430 141 503 125 572 98C625 78 671 63 720 54L720 248C665 233 621 217 571 213C504 206 431 225 348 238Z"/>
                            <path class="forecast-observed" d="M40 262C89 239 131 247 174 209C214 175 257 188 299 151C319 134 334 143 348 126"/>
                            <path class="forecast-line" d="M348 126C425 119 490 141 552 122C614 103 664 107 720 79"/>
                            <circle class="forecast-point" cx="348" cy="126" r="6"/>
                            <circle class="forecast-gate" cx="720" cy="79" r="8"/>
                        </svg>
                        <ul class="forecast-legend">
                            <li><span></span><%= __('studio_chart_observed') %></li>
                            <li><span></span><%= __('studio_chart_forecast') %></li>
                            <li><span></span><%= __('studio_chart_band') %></li>
                            <li><span></span><%= __('studio_chart_gate') %></li>
                        </ul>
                    </figure>
                    <div>
                        <ul class="fact-list">
                            <li><%= __('studio_timesfm_fact_1') %></li>
                            <li><%= __('studio_timesfm_fact_2') %></li>
                            <li><%= __('studio_timesfm_fact_3') %></li>
                        </ul>
                        <a class="text-link" href="https://github.com/Geoking2104/KayrosLab/blob/main/docs/TIMESFM_FORECASTING.md"><%= __('studio_timesfm_link') %></a>
                    </div>
                </div>
            </div>
        </section>

        <section id="open-source" class="section technical" aria-labelledby="technical-title">
            <div class="frame">
                <div class="section-head">
                    <span class="eyebrow"><%= __('studio_tech_label') %></span>
                    <h2 id="technical-title"><%= __('studio_tech_title') %></h2>
                    <p class="section-copy"><%= __('studio_tech_copy') %></p>
                </div>
                <div class="technical-layout">
                    <dl class="spec-sheet">
                        <div><dt><%= __('studio_spec_runtime_label') %></dt><dd><%= __('studio_spec_runtime_value') %></dd></div>
                        <div><dt><%= __('studio_spec_forecast_label') %></dt><dd><%= __('studio_spec_forecast_value') %></dd></div>
                        <div><dt><%= __('studio_spec_models_label') %></dt><dd><%= __('studio_spec_models_value') %></dd></div>
                        <div><dt><%= __('studio_spec_controls_label') %></dt><dd><%= __('studio_spec_controls_value') %></dd></div>
                        <div><dt><%= __('studio_spec_deploy_label') %></dt><dd><%= __('studio_spec_deploy_value') %></dd></div>
                    </dl>
                    <div class="code-panel">
                        <span><%= __('studio_code_label') %></span>
                        <pre><code>git clone https://github.com/Geoking2104/KayrosLab.git
cd KayrosLab/backend/fastify
npm install
npm start</code></pre>
                        <p class="license-note"><%= __('studio_license_note') %></p>
                    </div>
                </div>
            </div>
        </section>

        <section class="frame closing" aria-labelledby="closing-title">
            <div class="closing-callout">
                <div>
                    <h2 id="closing-title"><%= __('studio_closing_title') %></h2>
                    <p><%= __('studio_closing_copy') %></p>
                </div>
                <a class="button button--primary" href="mailto:<%= __('footer_email') %>?subject=<%= encodeURIComponent(__('simple_book_subject')) %>"><%= __('studio_closing_cta') %></a>
            </div>

            <details id="secure-workspace" class="workspace">
                <summary><%= __('sales_oracle_workspace_title') %></summary>
                <p class="workspace-intro"><%= __('sales_oracle_workspace_desc') %></p>
                <div class="sales-oracle-tool" data-sales-oracle-tool data-api-base="https://api.kayroslab.com"
                    data-login-required="<%= __('sales_oracle_tool_login_required') %>"
                    data-connecting="<%= __('sales_oracle_tool_connecting') %>"
                    data-connected="<%= __('sales_oracle_tool_connected') %>"
                    data-logged-out="<%= __('sales_oracle_tool_logged_out') %>"
                    data-creating-case="<%= __('sales_oracle_tool_creating_case') %>"
                    data-case-selected="<%= __('sales_oracle_tool_case_selected') %>"
                    data-choose-case="<%= __('sales_oracle_tool_choose_case') %>"
                    data-no-cases="<%= __('sales_oracle_tool_no_cases') %>"
                    data-no-documents="<%= __('sales_oracle_tool_no_documents') %>"
                    data-case-required="<%= __('sales_oracle_tool_case_required') %>"
                    data-files-required="<%= __('sales_oracle_tool_files_required') %>"
                    data-upload-complete="<%= __('sales_oracle_tool_upload_complete') %>"
                    data-error="<%= __('sales_oracle_tool_error') %>"
                    data-stage-hashing="<%= __('sales_oracle_tool_stage_hashing') %>"
                    data-stage-signing="<%= __('sales_oracle_tool_stage_signing') %>"
                    data-stage-uploading="<%= __('sales_oracle_tool_stage_uploading') %>"
                    data-stage-verifying="<%= __('sales_oracle_tool_stage_verifying') %>"
                    data-stage-queued="<%= __('sales_oracle_tool_stage_queued') %>">
                    <div class="sales-oracle-tool__header">
                        <div>
                            <div class="sales-oracle-tool__eyebrow"><span class="sales-oracle-tool__live" aria-hidden="true"></span><%= __('sales_oracle_tool_eyebrow') %></div>
                            <h3><%= __('sales_oracle_tool_title') %></h3>
                        </div>
                        <p><%= __('sales_oracle_tool_intro') %></p>
                    </div>
                    <p id="so-tool-status" class="sales-oracle-tool__status" role="status" aria-live="polite"></p>
                    <div class="sales-oracle-tool__grid">
                        <article class="sales-oracle-tool__panel">
                            <div class="sales-oracle-tool__step">01 · <%= __('sales_oracle_tool_session') %></div>
                            <h4><%= __('sales_oracle_tool_session_title') %></h4>
                            <p><%= __('sales_oracle_tool_session_desc') %></p>
                            <form id="so-login-form" class="sales-oracle-tool__form">
                                <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_email') %><input name="email" type="email" autocomplete="username" required></label>
                                <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_password') %><input name="password" type="password" autocomplete="current-password" required></label>
                                <div class="sales-oracle-tool__actions">
                                    <button class="sales-oracle-tool__button" type="submit"><%= __('sales_oracle_tool_connect') %></button>
                                    <button id="so-logout" class="sales-oracle-tool__button sales-oracle-tool__button--secondary" type="button" hidden><%= __('sales_oracle_tool_disconnect') %></button>
                                    <a class="sales-oracle-tool__link" href="mailto:<%= __('footer_email') %>?subject=<%= encodeURIComponent(__('sales_oracle_tool_access_subject')) %>"><%= __('sales_oracle_tool_request_access') %></a>
                                </div>
                            </form>
                            <p class="sales-oracle-tool__privacy"><%= __('sales_oracle_tool_session_privacy') %></p>
                        </article>
                        <article class="sales-oracle-tool__panel">
                            <div class="sales-oracle-tool__step">02 · <%= __('sales_oracle_tool_case') %></div>
                            <h4><%= __('sales_oracle_tool_case_title') %></h4>
                            <p><%= __('sales_oracle_tool_case_desc') %></p>
                            <fieldset id="so-case-fields" class="sales-oracle-tool__fields">
                                <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_existing_case') %><select id="so-case-select"><option><%= __('sales_oracle_tool_no_cases') %></option></select></label>
                                <form id="so-case-form" class="sales-oracle-tool__form" novalidate>
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_case_name') %><input name="name" maxlength="300" required></label>
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_use_case') %><select name="use_case"><option value="rfp"><%= __('sales_oracle_tool_use_rfp') %></option><option value="comex_decision"><%= __('sales_oracle_tool_use_comex') %></option><option value="renewal"><%= __('sales_oracle_tool_use_renewal') %></option><option value="negotiation"><%= __('sales_oracle_tool_use_negotiation') %></option></select></label>
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_question') %><textarea name="decision_question" maxlength="12000" required></textarea></label>
                                    <button class="sales-oracle-tool__button" type="submit"><%= __('sales_oracle_tool_create_case') %></button>
                                </form>
                            </fieldset>
                        </article>
                        <article class="sales-oracle-tool__panel">
                            <div class="sales-oracle-tool__step">03 · <%= __('sales_oracle_tool_corpus') %></div>
                            <h4><%= __('sales_oracle_tool_corpus_title') %></h4>
                            <p><%= __('sales_oracle_tool_corpus_desc') %></p>
                            <form id="so-upload-form" class="sales-oracle-tool__form" novalidate>
                                <fieldset id="so-upload-fields" class="sales-oracle-tool__fields">
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_source_type') %><select name="source_type"><option value="rfp"><%= __('sales_oracle_tool_source_rfp') %></option><option value="proposal"><%= __('sales_oracle_tool_source_proposal') %></option><option value="contract"><%= __('sales_oracle_tool_source_contract') %></option><option value="security"><%= __('sales_oracle_tool_source_security') %></option><option value="financial"><%= __('sales_oracle_tool_source_financial') %></option><option value="meeting_notes"><%= __('sales_oracle_tool_source_notes') %></option><option value="organization"><%= __('sales_oracle_tool_source_organization') %></option><option value="personality_profile"><%= __('sales_oracle_tool_source_profile') %></option><option value="other"><%= __('sales_oracle_tool_source_other') %></option></select></label>
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_files') %><input id="so-files" name="files" type="file" accept=".pdf,.docx,.txt,.md,.csv" multiple required></label>
                                    <button class="sales-oracle-tool__button" type="submit"><%= __('sales_oracle_tool_upload') %></button>
                                </fieldset>
                            </form>
                            <p class="sales-oracle-tool__privacy"><%= __('sales_oracle_tool_limits') %></p>
                        </article>
                    </div>
                    <ul id="so-document-list" class="sales-oracle-tool__documents" aria-label="<%= __('sales_oracle_tool_documents') %>"></ul>
                </div>
            </details>
        </section>
    </main>

    <footer class="frame site-footer">
        <p class="footer-statement"><%= __('studio_footer_statement') %></p>
        <div class="footer-line">
            <span>© <%= new Date().getFullYear() %> KayrosLab · <%= __('studio_proprietary') %></span>
            <nav class="footer-links" aria-label="<%= __('studio_footer_label') %>">
                <a href="/whitepaper-kayroslab.html">Whitepaper</a>
                <a href="https://github.com/Geoking2104/KayrosLab">GitHub</a>
                <a href="https://www.linkedin.com/in/gdelatournelle/">LinkedIn</a>
                <a href="mailto:<%= __('footer_email') %>"><%= __('simple_contact') %></a>
            </nav>
        </div>
    </footer>

    <script type="module" src="./assets/sales-oracle-tool.js"></script>
</body>
</html>
