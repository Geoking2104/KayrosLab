<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= __('site_title') %></title>
    <meta name="description" content="<%= __('simple_meta_description') %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@500;600&family=Geist:wght@400;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="./tokens.css">
    <style>
        /* Hallmark · genre: modern-minimal · macrostructure: Split Studio · theme: KayrosLab custom · palette: cool-blue paper / cyan accent · enrichment: F5 existing annotated dossier · nav: N5 Floating Pill · footer: Ft2 Inline · audience: enterprise decision-makers · use: decision rehearsal · tone: executive austere · pre-emit: P5 H5 E5 S5 R5 V5 · contrast: pass (46–50) · slop: pass (51–60) · mobile: pass (36, 59, 61–69) */
        *, *::before, *::after { box-sizing: border-box; }
        html, body { overflow-x: clip; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            background: var(--color-paper);
            color: var(--color-ink);
            font-family: var(--font-body);
            font-size: var(--text-base);
            line-height: 1.6;
            text-rendering: optimizeLegibility;
        }
        body, button, input, select, textarea { font-family: var(--font-body); }
        img { max-width: 100%; }
        a { color: inherit; }
        button, summary { -webkit-tap-highlight-color: transparent; }
        :focus-visible {
            outline: 2px solid var(--color-focus);
            outline-offset: 3px;
        }
        .skip-link {
            position: fixed;
            inset: var(--space-sm) auto auto var(--space-sm);
            z-index: var(--z-toast, 500);
            padding: var(--space-xs) var(--space-sm);
            border-radius: var(--radius-pill);
            background: var(--color-ink-deep);
            color: var(--color-paper);
            transform: translateY(-180%);
        }
        .skip-link:focus { transform: none; }
        .site-frame {
            width: min(100% - 2rem, 78rem);
            margin-inline: auto;
        }
        .section-title {
            max-width: 17ch;
            margin: 0;
            font-family: var(--font-display);
            font-size: clamp(2rem, 4vw, var(--text-3xl));
            font-weight: 700;
            letter-spacing: -0.035em;
            line-height: 1.08;
            overflow-wrap: anywhere;
            min-width: 0;
        }
        .section-copy {
            max-width: 62ch;
            margin: 0;
            color: var(--color-ink-2);
            font-size: var(--text-md);
        }
        .button {
            display: inline-flex;
            min-height: 3rem;
            align-items: center;
            justify-content: center;
            gap: var(--space-xs);
            width: max-content;
            max-width: 100%;
            padding-inline: var(--space-md);
            border: var(--rule-hair) solid var(--color-ink-deep);
            border-radius: var(--radius-pill);
            background: var(--color-paper);
            color: var(--color-ink-deep);
            font-weight: 700;
            line-height: 1;
            text-decoration: none;
            white-space: nowrap;
            transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
        }
        .button--primary {
            background: var(--color-ink-deep);
            color: var(--color-paper);
        }
        .button[aria-disabled="true"], .button:disabled {
            cursor: not-allowed;
            opacity: .55;
            pointer-events: none;
        }
        .button[data-state="loading"] { cursor: wait; }
        .button[data-state="error"] { border-color: var(--color-danger); }
        .button[data-state="success"] { border-color: var(--color-positive); }
        .nav-wrap {
            position: fixed;
            inset: var(--space-sm) 0 auto;
            z-index: var(--z-sticky, 200);
            pointer-events: none;
        }
        .nav-pill {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-sm);
            width: min(100% - 2rem, 45rem);
            min-height: 3.5rem;
            margin-inline: auto;
            padding: var(--space-2xs) var(--space-2xs) var(--space-2xs) var(--space-sm);
            border: var(--rule-hair) solid var(--color-rule);
            border-radius: var(--radius-pill);
            background: color-mix(in oklch, var(--color-paper) 88%, transparent);
            box-shadow: 0 .5rem 2rem color-mix(in oklch, var(--color-ink-deep) 12%, transparent);
            backdrop-filter: blur(.9rem) saturate(120%);
            pointer-events: auto;
        }
        .wordmark {
            flex: 0 0 auto;
            font-family: var(--font-display);
            font-size: var(--text-lg);
            font-weight: 700;
            letter-spacing: -0.04em;
            text-decoration: none;
            white-space: nowrap;
        }
        .nav-links { display: none; }
        .nav-links a, .language-links a, .mobile-nav a, .footer-links a {
            text-decoration: none;
            white-space: nowrap;
        }
        .nav-links a, .language-links a {
            min-height: 2.75rem;
            display: inline-flex;
            align-items: center;
            color: var(--color-ink-2);
            font-size: var(--text-sm);
            font-weight: 600;
        }
        .language-links { display: none; align-items: center; gap: var(--space-2xs); }
        .language-links a[aria-current="page"] { color: var(--color-accent-strong); }
        .nav-cta { display: none; min-height: 2.75rem; padding-inline: var(--space-sm); font-size: var(--text-sm); }
        .mobile-nav { position: relative; }
        .mobile-nav summary {
            display: grid;
            place-items: center;
            width: 2.75rem;
            height: 2.75rem;
            border-radius: var(--radius-pill);
            cursor: pointer;
            list-style: none;
        }
        .mobile-nav summary::-webkit-details-marker { display: none; }
        .mobile-nav__panel {
            position: absolute;
            inset: calc(100% + var(--space-sm)) 0 auto auto;
            display: grid;
            gap: var(--space-2xs);
            min-width: 14rem;
            padding: var(--space-sm);
            border: var(--rule-hair) solid var(--color-rule);
            border-radius: var(--radius-lg);
            background: var(--color-paper);
            box-shadow: 0 .75rem 2.5rem color-mix(in oklch, var(--color-ink-deep) 14%, transparent);
        }
        .mobile-nav__panel a {
            min-height: 2.75rem;
            display: flex;
            align-items: center;
            border-block-end: var(--rule-hair) solid var(--color-rule);
            font-weight: 600;
        }
        .mobile-nav__panel a:last-child { border-block-end: 0; }
        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-xl);
            align-items: center;
            padding-block: 8.5rem calc(2 * var(--space-3xl));
        }
        .hero-copy { min-width: 0; }
        .hero h1 {
            max-width: 12ch;
            margin: 0;
            font-family: var(--font-display);
            font-size: var(--text-display-s);
            font-weight: 700;
            letter-spacing: -0.055em;
            line-height: 1;
            overflow-wrap: anywhere;
            min-width: 0;
        }
        .hero-copy > p {
            max-width: 56ch;
            margin: var(--space-lg) 0 0;
            color: var(--color-ink-2);
            font-size: var(--text-md);
            overflow-wrap: anywhere;
        }
        .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-block-start: var(--space-lg); }
        .dossier-preview {
            min-width: 0;
            margin: 0;
            padding: var(--space-lg);
            border: var(--rule-hair) solid var(--color-rule-dark);
            border-radius: var(--radius-lg);
            background: var(--color-ink-deep);
            color: var(--color-paper);
        }
        .dossier-preview__head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-sm);
            padding-block-end: var(--space-md);
            border-block-end: var(--rule-hair) solid var(--color-rule-dark);
        }
        .dossier-preview__status {
            display: inline-flex;
            align-items: center;
            gap: var(--space-xs);
            color: var(--color-muted-on-dark);
            font-family: var(--font-body);
            font-size: var(--text-xs);
            font-weight: 600;
            letter-spacing: .08em;
        }
        .dossier-preview__status::before {
            content: "";
            width: .55rem;
            height: .55rem;
            border-radius: var(--radius-pill);
            background: var(--color-positive);
        }
        .dossier-preview h2 {
            margin: var(--space-md) 0 var(--space-lg);
            font-family: var(--font-display);
            font-size: var(--text-xl);
            line-height: 1.15;
            letter-spacing: -0.03em;
        }
        .dossier-preview dl { display: grid; gap: 0; margin: 0; }
        .dossier-preview__row {
            display: grid;
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-sm);
            padding-block: var(--space-sm);
            border-block-start: var(--rule-hair) solid var(--color-rule-dark);
        }
        .dossier-preview dt { color: var(--color-muted-on-dark); font-size: var(--text-sm); }
        .dossier-preview dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
        .use-cases { padding-block: var(--space-3xl) var(--space-2xl); }
        .use-cases__head { display: grid; gap: var(--space-md); margin-block-end: var(--space-xl); }
        .use-case-grid { display: grid; gap: var(--space-lg); }
        .use-case {
            min-width: 0;
            padding: var(--space-lg);
            border: var(--rule-hair) solid var(--color-rule);
            border-radius: var(--radius-lg);
            background: var(--color-paper-2);
        }
        .use-case--dark {
            background: var(--color-ink-deep);
            color: var(--color-paper);
        }
        .use-case h3 {
            margin: 0;
            font-family: var(--font-display);
            font-size: var(--text-xl);
            line-height: 1.15;
            letter-spacing: -0.03em;
        }
        .use-case p { margin: var(--space-sm) 0 0; color: var(--color-ink-2); }
        .use-case--dark p { color: var(--color-muted-on-dark); }
        .plain-list { display: grid; gap: var(--space-sm); margin: var(--space-lg) 0 0; padding: 0; list-style: none; }
        .plain-list li { display: grid; grid-template-columns: 1rem minmax(0, 1fr); gap: var(--space-xs); }
        .plain-list li::before { content: "→"; color: var(--color-accent); font-weight: 700; }
        .method {
            display: grid;
            gap: var(--space-xl);
            padding-block: var(--space-2xl) var(--space-3xl);
        }
        .method-steps { display: grid; gap: var(--space-md); margin: 0; padding: 0; list-style: none; counter-reset: method-step; }
        .method-step {
            counter-increment: method-step;
            display: grid;
            grid-template-columns: 2.5rem minmax(0, 1fr);
            gap: var(--space-sm);
            padding-block: var(--space-md);
            border-block-start: var(--rule-hair) solid var(--color-rule);
        }
        .method-step::before {
            content: counter(method-step, decimal-leading-zero);
            color: var(--color-accent-strong);
            font-family: var(--font-body);
            font-size: var(--text-sm);
            font-variant-numeric: tabular-nums;
        }
        .method-step h3 { margin: 0; font-family: var(--font-display); font-size: var(--text-lg); }
        .method-step p { margin: var(--space-xs) 0 0; color: var(--color-ink-2); }
        .text-link {
            display: inline-flex;
            align-items: center;
            gap: var(--space-xs);
            min-height: 2.75rem;
            width: max-content;
            max-width: 100%;
            color: var(--color-accent-strong);
            font-weight: 700;
            text-underline-offset: .25rem;
            white-space: nowrap;
        }
        .sample {
            padding-block: var(--space-2xl) var(--space-3xl);
            background: var(--color-paper-2);
        }
        .sample-grid { display: grid; gap: var(--space-xl); align-items: center; }
        .sample figure { margin: 0; min-width: 0; }
        .sample img {
            display: block;
            width: 100%;
            height: auto;
            border: var(--rule-hair) solid var(--color-rule);
            border-radius: var(--radius-md);
        }
        .annotation-list { display: grid; gap: var(--space-md); margin: var(--space-lg) 0 0; padding: 0; list-style: none; counter-reset: annotation; }
        .annotation-list li {
            counter-increment: annotation;
            display: grid;
            grid-template-columns: 2rem minmax(0, 1fr);
            gap: var(--space-sm);
            color: var(--color-ink-2);
        }
        .annotation-list li::before {
            content: counter(annotation);
            display: grid;
            place-items: center;
            width: 2rem;
            height: 2rem;
            border: var(--rule-hair) solid var(--color-accent-strong);
            border-radius: var(--radius-pill);
            color: var(--color-accent-strong);
            font-family: var(--font-mono);
            font-size: var(--text-xs);
        }
        .annotation-list strong { display: block; color: var(--color-ink); }
        .trust {
            display: grid;
            gap: var(--space-xl);
            padding-block: var(--space-3xl);
        }
        .trust-list { display: grid; gap: var(--space-sm); margin: 0; padding: 0; list-style: none; }
        .trust-list li {
            display: grid;
            grid-template-columns: 1.25rem minmax(0, 1fr);
            gap: var(--space-sm);
            padding-block: var(--space-xs);
            color: var(--color-ink-2);
        }
        .trust-list i { margin-block-start: .3rem; color: var(--color-positive); }
        .trust-links { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-block-start: var(--space-lg); }
        .closing { padding-block: var(--space-2xl); }
        .closing-card {
            display: grid;
            gap: var(--space-lg);
            align-items: end;
            padding: var(--space-xl);
            border-radius: var(--radius-xl);
            background: var(--color-ink-deep);
            color: var(--color-paper);
        }
        .closing-card h2 {
            max-width: 18ch;
            margin: 0;
            font-family: var(--font-display);
            font-size: clamp(2rem, 5vw, var(--text-3xl));
            line-height: 1.05;
            letter-spacing: -0.04em;
            overflow-wrap: anywhere;
        }
        .closing-card p { max-width: 56ch; margin: var(--space-sm) 0 0; color: var(--color-muted-on-dark); }
        .closing-card .button--primary { background: var(--color-paper); color: var(--color-ink-deep); }
        .workspace {
            margin-block-start: var(--space-lg);
            border-block: var(--rule-hair) solid var(--color-rule);
        }
        .workspace > summary {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: var(--space-sm);
            align-items: center;
            min-height: 3.5rem;
            cursor: pointer;
            font-weight: 700;
            list-style: none;
            white-space: nowrap;
        }
        .workspace > summary::-webkit-details-marker { display: none; }
        .workspace > summary i { transition: transform var(--dur-short) var(--ease-out); }
        .workspace[open] > summary i { transform: rotate(45deg); }
        .workspace-intro { margin: 0 0 var(--space-md); color: var(--color-ink-2); }
        .sales-oracle-tool {
            margin-block-end: var(--space-lg);
            overflow: clip;
            border: var(--rule-hair) solid var(--color-rule);
            border-radius: var(--radius-lg);
            background: var(--color-paper);
        }
        .sales-oracle-tool__header {
            display: grid;
            gap: var(--space-sm);
            padding: var(--space-lg);
            background: var(--color-ink-deep);
            color: var(--color-paper);
        }
        .sales-oracle-tool__eyebrow {
            display: flex;
            align-items: center;
            gap: var(--space-xs);
            color: var(--color-muted-on-dark);
            font-family: var(--font-mono);
            font-size: var(--text-xs);
            font-weight: 600;
            letter-spacing: .08em;
        }
        .sales-oracle-tool__live {
            width: .55rem;
            height: .55rem;
            border-radius: var(--radius-pill);
            background: var(--color-positive);
        }
        .sales-oracle-tool__header h3 { margin: 0; font-family: var(--font-display); font-size: var(--text-xl); }
        .sales-oracle-tool__header p { margin: 0; color: var(--color-muted-on-dark); }
        .sales-oracle-tool__status {
            min-height: 3rem;
            margin: 0;
            padding: var(--space-sm) var(--space-lg);
            border-block-end: var(--rule-hair) solid var(--color-rule);
            background: var(--color-paper-2);
            color: var(--color-ink-2);
            font-size: var(--text-sm);
        }
        .sales-oracle-tool__status[data-tone="success"] { background: var(--color-positive-soft); color: var(--color-ink); }
        .sales-oracle-tool__status[data-tone="error"] { border-color: var(--color-danger); color: var(--color-danger); }
        .sales-oracle-tool__grid { display: grid; }
        .sales-oracle-tool__panel { min-width: 0; padding: var(--space-lg); border-block-end: var(--rule-hair) solid var(--color-rule); }
        .sales-oracle-tool__step { margin-block-end: var(--space-xs); color: var(--color-accent-strong); font-family: var(--font-body); font-size: var(--text-xs); font-weight: 600; }
        .sales-oracle-tool__panel h4 { margin: 0; font-family: var(--font-display); font-size: var(--text-lg); }
        .sales-oracle-tool__panel > p { margin: var(--space-xs) 0 var(--space-md); color: var(--color-ink-2); font-size: var(--text-sm); }
        .sales-oracle-tool__form, .sales-oracle-tool__fields { display: grid; gap: var(--space-sm); margin: 0; padding: 0; border: 0; }
        .sales-oracle-tool__field { display: grid; gap: var(--space-2xs); min-width: 0; font-size: var(--text-sm); font-weight: 600; }
        .sales-oracle-tool__field input, .sales-oracle-tool__field select, .sales-oracle-tool__field textarea {
            width: 100%;
            min-height: 2.75rem;
            padding: var(--space-xs) var(--space-sm);
            border: var(--rule-hair) solid var(--color-rule);
            outline: 2px solid transparent;
            outline-offset: 1px;
            border-radius: var(--radius-sm);
            background: var(--color-paper);
            color: var(--color-ink);
            font: inherit;
            font-weight: 400;
        }
        .sales-oracle-tool__field textarea { min-height: 6rem; resize: vertical; }
        .sales-oracle-tool__field input:focus-visible, .sales-oracle-tool__field select:focus-visible, .sales-oracle-tool__field textarea:focus-visible { outline-color: var(--color-focus); }
        .sales-oracle-tool__field input:disabled, .sales-oracle-tool__field select:disabled, .sales-oracle-tool__field textarea:disabled { cursor: not-allowed; opacity: .55; }
        .sales-oracle-tool__field input[aria-invalid="true"], .sales-oracle-tool__field select[aria-invalid="true"], .sales-oracle-tool__field textarea[aria-invalid="true"] { border-color: var(--color-danger); }
        .sales-oracle-tool__button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-xs);
            min-height: 2.75rem;
            padding-inline: var(--space-sm);
            border: var(--rule-hair) solid var(--color-ink-deep);
            border-radius: var(--radius-sm);
            background: var(--color-ink-deep);
            color: var(--color-paper);
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: background-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
        }
        .sales-oracle-tool__button--secondary { background: var(--color-paper); color: var(--color-ink); }
        .sales-oracle-tool__button:disabled { cursor: wait; opacity: .55; }
        .sales-oracle-tool__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs); }
        .sales-oracle-tool__link { color: var(--color-accent-strong); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; }
        .sales-oracle-tool__privacy { margin: var(--space-sm) 0 0; color: var(--color-ink-2); font-size: var(--text-xs); }
        .sales-oracle-tool__documents { margin: 0; padding: var(--space-md) var(--space-lg); background: var(--color-paper-2); list-style: none; }
        .sales-oracle-tool__document, .sales-oracle-tool__empty { display: flex; justify-content: space-between; gap: var(--space-sm); padding-block: var(--space-xs); border-block-end: var(--rule-hair) solid var(--color-rule); color: var(--color-ink-2); font-size: var(--text-sm); overflow-wrap: anywhere; }
        .sales-oracle-tool__document-state { flex: 0 0 auto; color: var(--color-positive); font-family: var(--font-body); font-size: var(--text-xs); }
        .site-footer { padding-block: var(--space-xl); }
        .site-footer__line {
            display: flex;
            flex-direction: column;
            gap: var(--space-md);
            padding-block-start: var(--space-lg);
            border-block-start: var(--rule-hair) solid var(--color-rule);
            color: var(--color-ink-2);
            font-size: var(--text-sm);
        }
        .footer-links { display: flex; flex-wrap: wrap; gap: var(--space-md); }
        @media (hover: hover) and (pointer: fine) {
            .button:hover { transform: translateY(-1px); }
            .button--primary:hover { background: var(--color-ink); }
            .nav-links a:hover, .language-links a:hover, .mobile-nav a:hover, .footer-links a:hover, .text-link:hover { color: var(--color-accent-strong); }
            .sales-oracle-tool__button:hover { background: var(--color-ink); }
            .sales-oracle-tool__button--secondary:hover { background: var(--color-paper-2); color: var(--color-ink); }
        }
        .button:active, .sales-oracle-tool__button:active { transform: translateY(1px); }
        .nav-links a:active, .language-links a:active, .mobile-nav a:active, .footer-links a:active, .text-link:active, .sales-oracle-tool__link:active { color: var(--color-accent-strong); }
        @media (min-width: 40rem) {
            .site-frame { width: min(100% - 3rem, 78rem); }
            .nav-cta { display: inline-flex; }
            .dossier-preview__row { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
            .hero, .use-case-grid, .sample-grid, .trust, .closing-card { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .site-footer__line { flex-direction: row; align-items: center; justify-content: space-between; }
        }
        @media (min-width: 60rem) {
            .nav-pill { width: min(100% - 3rem, 45rem); }
            .nav-links { display: flex; align-items: center; gap: var(--space-sm); }
            .language-links { display: flex; }
            .mobile-nav { display: none; }
            .hero { grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: var(--space-2xl); padding-block-start: 10rem; }
            .use-cases__head { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); align-items: end; }
            .use-case-grid { grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); }
            .use-case--dark { margin-block-start: var(--space-xl); }
            .method { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
            .sample-grid { grid-template-columns: minmax(0, 1.12fr) minmax(0, .88fr); }
            .trust { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
            .closing-card { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); }
            .closing-card__action { justify-self: end; }
            .sales-oracle-tool__header { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); align-items: end; }
            .sales-oracle-tool__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .sales-oracle-tool__panel { border-inline-end: var(--rule-hair) solid var(--color-rule); border-block-end: 0; }
            .sales-oracle-tool__panel:last-child { border-inline-end: 0; }
        }
        @media (pointer: coarse) {
            .button, .nav-links a, .language-links a, .mobile-nav summary, .mobile-nav__panel a, .text-link, .sales-oracle-tool__button, .sales-oracle-tool__link { min-height: 3rem; }
        }
        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            *, *::before, *::after { animation-duration: 150ms !important; animation-iteration-count: 1 !important; transition-duration: 150ms !important; }
            .button:hover { transform: none; }
        }
    </style>
</head>
<body>
    <a class="skip-link" href="#main"><%= __('simple_skip') %></a>

    <div class="nav-wrap">
        <nav class="nav-pill" aria-label="<%= __('simple_nav_label') %>">
            <a class="wordmark" href="/">KayrosLab</a>
            <div class="nav-links">
                <a href="#how-it-works"><%= __('simple_nav_product') %></a>
                <a href="#use-cases"><%= __('simple_nav_use_cases') %></a>
                <a href="#trust"><%= __('simple_nav_trust') %></a>
                <a href="/whitepaper-kayroslab.html"><%= __('simple_nav_resources') %></a>
            </div>
            <div class="language-links" aria-label="<%= __('simple_language_label') %>">
                <a href="/" <%= locale === 'en' ? 'aria-current="page"' : '' %>>EN</a>
                <a href="/index.fr.html" <%= locale === 'fr' ? 'aria-current="page"' : '' %>>FR</a>
            </div>
            <a class="button nav-cta" href="mailto:<%= __('footer_email') %>?subject=<%= encodeURIComponent(__('simple_book_subject')) %>"><%= __('simple_nav_book') %></a>
            <details class="mobile-nav">
                <summary aria-label="<%= __('simple_menu') %>"><i class="fa-solid fa-bars" aria-hidden="true"></i></summary>
                <div class="mobile-nav__panel">
                    <a href="#how-it-works"><%= __('simple_nav_product') %></a>
                    <a href="#use-cases"><%= __('simple_nav_use_cases') %></a>
                    <a href="#trust"><%= __('simple_nav_trust') %></a>
                    <a href="/whitepaper-kayroslab.html"><%= __('simple_nav_resources') %></a>
                    <a href="/"><%= __('simple_language_en') %></a>
                    <a href="/index.fr.html"><%= __('simple_language_fr') %></a>
                </div>
            </details>
        </nav>
    </div>

    <main id="main">
        <header class="site-frame hero">
            <div class="hero-copy">
                <h1><%= __('simple_hero_title') %></h1>
                <p><%= __('simple_hero_copy') %></p>
                <div class="hero-actions">
                    <a class="button button--primary" href="/kayroslab-complete-with-ai-agents.html"><%= __('simple_hero_primary') %><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                    <a class="button" href="#sample-dossier"><%= __('simple_hero_secondary') %></a>
                </div>
            </div>

            <aside class="dossier-preview" aria-label="<%= __('simple_preview_aria') %>">
                <div class="dossier-preview__head">
                    <span class="dossier-preview__status"><%= __('simple_preview_status') %></span>
                    <span><%= __('simple_preview_case') %></span>
                </div>
                <h2><%= __('simple_preview_title') %></h2>
                <dl>
                    <div class="dossier-preview__row"><dt><%= __('simple_preview_map_label') %></dt><dd><%= __('simple_preview_map_value') %></dd></div>
                    <div class="dossier-preview__row"><dt><%= __('simple_preview_veto_label') %></dt><dd><%= __('simple_preview_veto_value') %></dd></div>
                    <div class="dossier-preview__row"><dt><%= __('simple_preview_evidence_label') %></dt><dd><%= __('simple_preview_evidence_value') %></dd></div>
                    <div class="dossier-preview__row"><dt><%= __('simple_preview_action_label') %></dt><dd><%= __('simple_preview_action_value') %></dd></div>
                </dl>
            </aside>
        </header>

        <section id="use-cases" class="site-frame use-cases" aria-labelledby="use-cases-title">
            <div class="use-cases__head">
                <h2 id="use-cases-title" class="section-title"><%= __('simple_use_cases_title') %></h2>
                <p class="section-copy"><%= __('simple_use_cases_copy') %></p>
            </div>
            <div class="use-case-grid">
                <article class="use-case">
                    <h3><%= __('simple_comex_title') %></h3>
                    <p><%= __('simple_comex_copy') %></p>
                    <ul class="plain-list">
                        <li><%= __('simple_comex_point_1') %></li>
                        <li><%= __('simple_comex_point_2') %></li>
                        <li><%= __('simple_comex_point_3') %></li>
                    </ul>
                </article>
                <article class="use-case use-case--dark">
                    <h3><%= __('simple_rfp_title') %></h3>
                    <p><%= __('simple_rfp_copy') %></p>
                    <ul class="plain-list">
                        <li><%= __('simple_rfp_point_1') %></li>
                        <li><%= __('simple_rfp_point_2') %></li>
                        <li><%= __('simple_rfp_point_3') %></li>
                    </ul>
                </article>
            </div>
        </section>

        <section id="how-it-works" class="site-frame method" aria-labelledby="method-title">
            <div>
                <h2 id="method-title" class="section-title"><%= __('simple_method_title') %></h2>
                <p class="section-copy"><%= __('simple_method_copy') %></p>
                <a class="text-link" href="/kayroslab-complete-with-ai-agents.html"><%= __('simple_method_link') %><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <ol class="method-steps">
                <li class="method-step"><div><h3><%= __('simple_step_1_title') %></h3><p><%= __('simple_step_1_copy') %></p></div></li>
                <li class="method-step"><div><h3><%= __('simple_step_2_title') %></h3><p><%= __('simple_step_2_copy') %></p></div></li>
                <li class="method-step"><div><h3><%= __('simple_step_3_title') %></h3><p><%= __('simple_step_3_copy') %></p></div></li>
            </ol>
        </section>

        <section id="sample-dossier" class="sample" aria-labelledby="sample-title">
            <div class="site-frame sample-grid">
                <figure>
                    <img src="./assets/hybrid-agent-sales-oracle.png" width="1680" height="935" loading="lazy" decoding="async" alt="<%= __('simple_sample_alt') %>">
                </figure>
                <div>
                    <h2 id="sample-title" class="section-title"><%= __('simple_sample_title') %></h2>
                    <p class="section-copy"><%= __('simple_sample_copy') %></p>
                    <ol class="annotation-list">
                        <li><span><strong><%= __('simple_output_1_title') %></strong><%= __('simple_output_1_copy') %></span></li>
                        <li><span><strong><%= __('simple_output_2_title') %></strong><%= __('simple_output_2_copy') %></span></li>
                        <li><span><strong><%= __('simple_output_3_title') %></strong><%= __('simple_output_3_copy') %></span></li>
                        <li><span><strong><%= __('simple_output_4_title') %></strong><%= __('simple_output_4_copy') %></span></li>
                    </ol>
                </div>
            </div>
        </section>

        <section id="trust" class="site-frame trust" aria-labelledby="trust-title">
            <div>
                <h2 id="trust-title" class="section-title"><%= __('simple_trust_title') %></h2>
                <p class="section-copy"><%= __('simple_trust_copy') %></p>
                <div class="trust-links">
                    <a class="text-link" href="https://github.com/Geoking2104/KayrosLab"><%= __('simple_trust_architecture') %><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                    <a class="text-link" href="/whitepaper-kayroslab.html"><%= __('simple_trust_resources') %><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>
            <ul class="trust-list">
                <% for (let item = 1; item <= 5; item++) { -%>
                <li><i class="fa-solid fa-check" aria-hidden="true"></i><%= __('simple_trust_' + item) %></li>
                <% } -%>
            </ul>
        </section>

        <section class="site-frame closing" aria-labelledby="closing-title">
            <div class="closing-card">
                <div>
                    <h2 id="closing-title"><%= __('simple_closing_title') %></h2>
                    <p><%= __('simple_closing_copy') %></p>
                </div>
                <div class="closing-card__action">
                    <a class="button button--primary" href="mailto:<%= __('footer_email') %>?subject=<%= encodeURIComponent(__('simple_book_subject')) %>"><%= __('simple_closing_cta') %><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>

            <details id="secure-workspace" class="workspace">
                <summary><%= __('sales_oracle_workspace_title') %><i class="fa-solid fa-plus" aria-hidden="true"></i></summary>
                <p class="workspace-intro"><%= __('sales_oracle_workspace_desc') %></p>
                <div class="sales-oracle-tool" data-sales-oracle-tool data-api-base="https://api.kayroslab.com"
                    data-login-required="<%= __('sales_oracle_tool_login_required') %>"
                    data-connecting="<%= __('sales_oracle_tool_connecting') %>"
                    data-connected="<%= __('sales_oracle_tool_connected') %>"
                    data-logged-out="<%= __('sales_oracle_tool_logged_out') %>"
                    data-creating-case="<%= __('sales_oracle_tool_creating_case') %>"
                    data-case-selected="<%= __('sales_oracle_tool_case_selected') %>"
                    data-choose-case="<%= __('sales_oracle_tool_choose_case') %>"
                    data-no-cases="<%= __('sales_oracle_tool_no_cases') %>"
                    data-no-documents="<%= __('sales_oracle_tool_no_documents') %>"
                    data-case-required="<%= __('sales_oracle_tool_case_required') %>"
                    data-files-required="<%= __('sales_oracle_tool_files_required') %>"
                    data-upload-complete="<%= __('sales_oracle_tool_upload_complete') %>"
                    data-error="<%= __('sales_oracle_tool_error') %>"
                    data-stage-hashing="<%= __('sales_oracle_tool_stage_hashing') %>"
                    data-stage-signing="<%= __('sales_oracle_tool_stage_signing') %>"
                    data-stage-uploading="<%= __('sales_oracle_tool_stage_uploading') %>"
                    data-stage-verifying="<%= __('sales_oracle_tool_stage_verifying') %>"
                    data-stage-queued="<%= __('sales_oracle_tool_stage_queued') %>">
                    <div class="sales-oracle-tool__header">
                        <div>
                            <div class="sales-oracle-tool__eyebrow"><span class="sales-oracle-tool__live" aria-hidden="true"></span><%= __('sales_oracle_tool_eyebrow') %></div>
                            <h3><%= __('sales_oracle_tool_title') %></h3>
                        </div>
                        <p><%= __('sales_oracle_tool_intro') %></p>
                    </div>
                    <p id="so-tool-status" class="sales-oracle-tool__status" role="status" aria-live="polite"></p>
                    <div class="sales-oracle-tool__grid">
                        <article class="sales-oracle-tool__panel">
                            <div class="sales-oracle-tool__step">01 · <%= __('sales_oracle_tool_session') %></div>
                            <h4><%= __('sales_oracle_tool_session_title') %></h4>
                            <p><%= __('sales_oracle_tool_session_desc') %></p>
                            <form id="so-login-form" class="sales-oracle-tool__form">
                                <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_email') %><input name="email" type="email" autocomplete="username" required></label>
                                <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_password') %><input name="password" type="password" autocomplete="current-password" required></label>
                                <div class="sales-oracle-tool__actions">
                                    <button class="sales-oracle-tool__button" type="submit"><i class="fa-solid fa-lock" aria-hidden="true"></i><%= __('sales_oracle_tool_connect') %></button>
                                    <button id="so-logout" class="sales-oracle-tool__button sales-oracle-tool__button--secondary" type="button" hidden><%= __('sales_oracle_tool_disconnect') %></button>
                                    <a class="sales-oracle-tool__link" href="mailto:<%= __('footer_email') %>?subject=<%= encodeURIComponent(__('sales_oracle_tool_access_subject')) %>"><%= __('sales_oracle_tool_request_access') %></a>
                                </div>
                            </form>
                            <p class="sales-oracle-tool__privacy"><%= __('sales_oracle_tool_session_privacy') %></p>
                        </article>
                        <article class="sales-oracle-tool__panel">
                            <div class="sales-oracle-tool__step">02 · <%= __('sales_oracle_tool_case') %></div>
                            <h4><%= __('sales_oracle_tool_case_title') %></h4>
                            <p><%= __('sales_oracle_tool_case_desc') %></p>
                            <fieldset id="so-case-fields" class="sales-oracle-tool__fields">
                                <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_existing_case') %><select id="so-case-select"><option><%= __('sales_oracle_tool_no_cases') %></option></select></label>
                                <form id="so-case-form" class="sales-oracle-tool__form" novalidate>
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_case_name') %><input name="name" maxlength="300" required></label>
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_use_case') %><select name="use_case"><option value="rfp"><%= __('sales_oracle_tool_use_rfp') %></option><option value="comex_decision"><%= __('sales_oracle_tool_use_comex') %></option><option value="renewal"><%= __('sales_oracle_tool_use_renewal') %></option><option value="negotiation"><%= __('sales_oracle_tool_use_negotiation') %></option></select></label>
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_question') %><textarea name="decision_question" maxlength="12000" required></textarea></label>
                                    <button class="sales-oracle-tool__button" type="submit"><i class="fa-solid fa-folder-plus" aria-hidden="true"></i><%= __('sales_oracle_tool_create_case') %></button>
                                </form>
                            </fieldset>
                        </article>
                        <article class="sales-oracle-tool__panel">
                            <div class="sales-oracle-tool__step">03 · <%= __('sales_oracle_tool_corpus') %></div>
                            <h4><%= __('sales_oracle_tool_corpus_title') %></h4>
                            <p><%= __('sales_oracle_tool_corpus_desc') %></p>
                            <form id="so-upload-form" class="sales-oracle-tool__form" novalidate>
                                <fieldset id="so-upload-fields" class="sales-oracle-tool__fields">
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_source_type') %><select name="source_type"><option value="rfp"><%= __('sales_oracle_tool_source_rfp') %></option><option value="proposal"><%= __('sales_oracle_tool_source_proposal') %></option><option value="contract"><%= __('sales_oracle_tool_source_contract') %></option><option value="security"><%= __('sales_oracle_tool_source_security') %></option><option value="financial"><%= __('sales_oracle_tool_source_financial') %></option><option value="meeting_notes"><%= __('sales_oracle_tool_source_notes') %></option><option value="organization"><%= __('sales_oracle_tool_source_organization') %></option><option value="personality_profile"><%= __('sales_oracle_tool_source_profile') %></option><option value="other"><%= __('sales_oracle_tool_source_other') %></option></select></label>
                                    <label class="sales-oracle-tool__field"><%= __('sales_oracle_tool_files') %><input id="so-files" name="files" type="file" accept=".pdf,.docx,.txt,.md,.csv" multiple required></label>
                                    <button class="sales-oracle-tool__button" type="submit"><i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i><%= __('sales_oracle_tool_upload') %></button>
                                </fieldset>
                            </form>
                            <p class="sales-oracle-tool__privacy"><%= __('sales_oracle_tool_limits') %></p>
                        </article>
                    </div>
                    <ul id="so-document-list" class="sales-oracle-tool__documents" aria-label="<%= __('sales_oracle_tool_documents') %>"></ul>
                </div>
            </details>
        </section>
    </main>

    <footer class="site-frame site-footer">
        <div class="site-footer__line">
            <span><strong>KayrosLab</strong> · <%- __('footer_rights', new Date().getFullYear()) %></span>
            <nav class="footer-links" aria-label="<%= __('simple_footer_label') %>">
                <a href="/whitepaper-kayroslab.html"><%= __('simple_nav_resources') %></a>
                <a href="https://github.com/Geoking2104/KayrosLab">GitHub</a>
                <a href="https://www.linkedin.com/in/gdelatournelle/">LinkedIn</a>
                <a href="mailto:<%= __('footer_email') %>"><%= __('simple_contact') %></a>
            </nav>
        </div>
    </footer>

    <script type="module" src="./assets/sales-oracle-tool.js"></script>
</body>
</html>
