<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= __('site_title') %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;600&display=swap');
        :root { --primary: #0f172a; }
        body { font-family: 'Inter', system-ui, sans-serif; }
        .font-display { font-family: 'Space Grotesk', 'Inter', sans-serif; font-weight: 600; }
        .section-header { font-size: 2.25rem; line-height: 2.5rem; font-weight: 700; letter-spacing: -0.025em; }
        .nav-active { color: #0ea5e9; font-weight: 600; }
        .step-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .step-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
        .comparison-table th { background-color: #0f172a; color: white; font-weight: 600; }
        .comparison-table td { transition: background-color 0.2s ease; }
        .comparison-table tr:hover td { background-color: #f8fafc; }
        .pricing-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .pricing-card.popular { border-color: #0ea5e9; box-shadow: 0 25px 50px -12px rgb(14 165 233 / 0.25); transform: scale(1.02); }
        .glass { background: rgba(255,255,255, 0.95); backdrop-filter: blur(20px); }
        .hero-bg { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); }
        .nav-scrolled { box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.05), 0 4px 6px -4px rgb(0 0 0 / 0.05); }
        .modern-table { border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 10px -3px rgb(0 0 0 / 0.05); }
        .feature-check { color: #10b981; }
        .kayros-gradient { background: linear-gradient(90deg, #0ea5e9, #0284c8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        /* Mega-menu styles */
        .mega-menu { display: none; position: absolute; left: 50%; transform: translateX(-50%); top: 100%; width: 100vw; max-width: 1200px; }
        .group:hover .mega-menu { display: block; }
        .mega-menu a { transition: all 0.2s ease; }
        .mega-menu-overlay { display: none; }
        .group:hover .mega-menu-overlay ~ .mega-menu { display: block; }
        @media (max-width: 1023px) { .mega-menu { position: static; transform: none; width: 100%; max-width: 100%; } }
        
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }
        @keyframes slideInLeft { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: translateX(0); } }
        
        .animate-on-scroll { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
        .animate-on-scroll.is-visible { opacity: 1; transform: translateY(0); }
        .stagger-children > * { opacity: 0; transform: translateY(16px); transition: opacity 0.5s ease, transform 0.5s ease; }
        .stagger-children.is-visible > * { opacity: 1; transform: translateY(0); }
        .stagger-children.is-visible > *:nth-child(1) { transition-delay: 0.05s; }
        .stagger-children.is-visible > *:nth-child(2) { transition-delay: 0.10s; }
        .stagger-children.is-visible > *:nth-child(3) { transition-delay: 0.15s; }
        .stagger-children.is-visible > *:nth-child(4) { transition-delay: 0.20s; }
        .stagger-children.is-visible > *:nth-child(5) { transition-delay: 0.25s; }
        .stagger-children.is-visible > *:nth-child(6) { transition-delay: 0.30s; }
        .stagger-children.is-visible > *:nth-child(7) { transition-delay: 0.35s; }
        .stagger-children.is-visible > *:nth-child(8) { transition-delay: 0.40s; }
    </style>
</head>
