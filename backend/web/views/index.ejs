<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= __('site_title') %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="./tokens.css">
    <style>
        /* Hallmark · genre: modern-minimal · macrostructure: Long Document (Sales Oracle scope) · theme: KayrosLab custom · vibe: plain-language, executive, restrained · anchor: cyan · enrichment: Tier C generated editorial still · nav: N9 · footer: Ft5 · contrast: pass (46–50) · honest: pass (56) · chrome: pass (57) · responsive: pass (59) · icons: pass (60) · mobile: pass (36, 59, 61–69) */
        /* Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V5 */
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;600&display=swap');
        :root { --primary: #0f172a; }
        body { font-family: 'Inter', system-ui, sans-serif; }
        .font-display { font-family: 'Space Grotesk', 'Inter', sans-serif; font-weight: 600; }
        .section-header { font-size: 2.25rem; line-height: 2.5rem; font-weight: 700; letter-spacing: -0.025em; }
        .nav-active { color: #0ea5e9; font-weight: 600; }
        .step-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .step-card:hover { transform: translateY(-4px); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
        .comparison-table th { background-color: #0f172a; color: white; font-weight: 600; }
        .comparison-table td { transition: background-color 0.2s ease; }
        .comparison-table tr:hover td { background-color: #f8fafc; }
        .pricing-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .pricing-card.popular { border-color: #0ea5e9; box-shadow: 0 25px 50px -12px rgb(14 165 233 / 0.25); transform: scale(1.02); }
        .glass { background: rgba(255,255,255, 0.95); backdrop-filter: blur(20px); }
        .hero-bg { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); }
        .nav-scrolled { box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.05), 0 4px 6px -4px rgb(0 0 0 / 0.05); }
        .modern-table { border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 10px -3px rgb(0 0 0 / 0.05); }
        .feature-check { color: #10b981; }
        .kayros-gradient { background: linear-gradient(90deg, #0ea5e9, #0284c8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        /* Mega-menu styles */
        .mega-menu { display: none; position: absolute; left: 0; top: 100%; min-width: 280px; }
        .mega-menu-wide { display: none; position: absolute; left: 50%; transform: translateX(-50%); top: 100%; width: 90vw; max-width: 1100px; }
        .group:hover > .mega-menu { display: block; }
        .group:hover > .mega-menu-wide { display: block; }
        .mega-menu a, .mega-menu-wide a { transition: all 0.2s ease; }
        /* Mobile tap support for dropdowns */
        .dropdown-toggle.active + .mega-menu, .dropdown-toggle.active + .mega-menu-wide { display: block; }
        .dropdown-toggle.active i.fa-chevron-down { transform: rotate(180deg); }
        @media (max-width: 1023px) {
            .mega-menu, .mega-menu-wide { position: static !important; left: auto !important; transform: none !important; width: 100% !important; max-width: 100% !important; min-width: auto !important; }
            .group:hover > .mega-menu, .group:hover > .mega-menu-wide { display: none; }
            .dropdown-toggle.active + .mega-menu, .dropdown-toggle.active + .mega-menu-wide { display: block !important; }
        }
        /* Mobile menu scroll */
        #mobile-menu { max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.35s ease, opacity 0.3s ease; }
        #mobile-menu.open { max-height: 80vh !important; opacity: 1 !important; overflow-y: auto; }
        
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes scaleIn { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }
        @keyframes slideInLeft { from { opacity: 0; transform: translateX(-24px); } to { opacity: 1; transform: translateX(0); } }
        
        .animate-on-scroll { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
        .animate-on-scroll.is-visible { opacity: 1; transform: translateY(0); }
        .stagger-children > * { opacity: 0; transform: translateY(16px); transition: opacity 0.5s ease, transform 0.5s ease; }
        .stagger-children.is-visible > * { opacity: 1; transform: translateY(0); }
        .stagger-children.is-visible > *:nth-child(1) { transition-delay: 0.05s; }
        .stagger-children.is-visible > *:nth-child(2) { transition-delay: 0.10s; }
        .stagger-children.is-visible > *:nth-child(3) { transition-delay: 0.15s; }
        .stagger-children.is-visible > *:nth-child(4) { transition-delay: 0.20s; }
        .stagger-children.is-visible > *:nth-child(5) { transition-delay: 0.25s; }
        .stagger-children.is-visible > *:nth-child(6) { transition-delay: 0.30s; }
        .stagger-children.is-visible > *:nth-child(7) { transition-delay: 0.35s; }
        .stagger-children.is-visible > *:nth-child(8) { transition-delay: 0.40s; }

        html, body { overflow-x: clip; }
        .sales-oracle { background: var(--color-paper); color: var(--color-ink); }
        .sales-oracle__inner { max-width: 78rem; margin-inline: auto; padding: var(--space-2xl) var(--space-sm); }
        .sales-oracle__head { display: grid; gap: var(--space-lg); margin-block-end: var(--space-xl); }
        .sales-oracle__head h2 { margin: 0; max-width: 15ch; color: var(--color-ink); font-family: var(--font-display); font-size: var(--text-display-s); font-weight: 700; letter-spacing: -0.045em; line-height: 1.02; overflow-wrap: anywhere; min-width: 0; }
        .sales-oracle__head-copy { display: grid; gap: var(--space-md); align-content: end; }
        .sales-oracle__head-copy p { margin: 0; max-width: 58ch; color: var(--color-ink-2); font-size: var(--text-md); line-height: 1.65; }
        .sales-oracle__cta { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-xs); min-height: 3.25rem; width: max-content; max-width: 100%; padding-inline: var(--space-lg); border: var(--rule-hair) solid var(--color-ink-deep); border-radius: var(--radius-pill); background: var(--color-ink-deep); color: var(--color-paper); font-weight: 700; text-decoration: none; white-space: nowrap; transition: transform var(--dur-micro) var(--ease-out), opacity var(--dur-micro) var(--ease-out); }
        .sales-oracle__cta:hover { transform: translateY(-1px); }
        .sales-oracle__cta:active { transform: translateY(1px); }
        .sales-oracle__cta:focus-visible, .sales-oracle__workspace summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }
        .sales-oracle__overview { display: grid; gap: var(--space-lg); align-items: start; padding-block: var(--space-xl); border-block: var(--rule-hair) solid var(--color-rule); }
        .sales-oracle__figure { margin: 0; overflow: hidden; border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-md); background: var(--color-ink-deep); }
        .sales-oracle__figure img { display: block; width: 100%; height: auto; aspect-ratio: 1680 / 935; object-fit: cover; }
        .sales-oracle__explanation { display: grid; gap: var(--space-lg); }
        .sales-oracle__explanation h3, .sales-oracle__outputs h3 { margin: 0; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; letter-spacing: -0.025em; }
        .sales-oracle__steps { display: grid; gap: var(--space-md); list-style: none; margin: 0; padding: 0; counter-reset: oracle-step; }
        .sales-oracle__step { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-sm); color: var(--color-ink-2); line-height: 1.55; counter-increment: oracle-step; }
        .sales-oracle__step::before { content: counter(oracle-step); display: grid; place-items: center; width: 2rem; height: 2rem; border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-pill); color: var(--color-accent-strong); font-family: var(--font-mono); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
        .sales-oracle__step strong { display: block; margin-block-end: var(--space-3xs); color: var(--color-ink); }
        .sales-oracle__outputs { display: grid; gap: var(--space-md); padding: var(--space-lg); border-radius: var(--radius-md); background: var(--color-ink-deep); color: var(--color-paper); }
        .sales-oracle__output-list { display: grid; gap: var(--space-sm); margin: 0; padding: 0; list-style: none; }
        .sales-oracle__output-list li { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: var(--space-xs); color: var(--color-muted-on-dark); line-height: 1.5; }
        .sales-oracle__output-list i { margin-block-start: var(--space-3xs); color: var(--color-positive); }
        .sales-oracle__note { margin: 0; max-width: 70ch; color: var(--color-ink-2); font-size: var(--text-sm); line-height: 1.6; }
        .sales-oracle__workspace { margin-block-start: var(--space-xl); border-block: var(--rule-hair) solid var(--color-rule); }
        .sales-oracle__workspace summary { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-sm); align-items: center; padding-block: var(--space-md); cursor: pointer; list-style: none; font-weight: 700; }
        .sales-oracle__workspace summary::-webkit-details-marker { display: none; }
        .sales-oracle__workspace summary { white-space: nowrap; }
        .sales-oracle__workspace summary i { transition: transform var(--dur-short) var(--ease-out); }
        .sales-oracle__workspace[open] summary i { transform: rotate(45deg); }
        .sales-oracle__workspace-intro { margin: 0 0 var(--space-md); color: var(--color-ink-2); font-size: var(--text-sm); line-height: 1.5; }
        .sales-oracle-tool { margin-block-end: var(--space-lg); overflow: hidden; border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-lg); background: var(--color-paper); }
        .sales-oracle-tool__header { display: grid; gap: var(--space-sm); padding: var(--space-lg); color: var(--color-paper); background: var(--color-ink-deep); }
        .sales-oracle-tool__eyebrow { display: flex; align-items: center; gap: var(--space-xs); color: #7dd3fc; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
        .sales-oracle-tool__live { display: inline-block; width: .55rem; height: .55rem; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 .25rem rgba(52, 211, 153, .16); }
        .sales-oracle-tool__header h3 { margin: 0; max-width: 22ch; font-family: var(--font-display); font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.08; letter-spacing: -.03em; }
        .sales-oracle-tool__header p { margin: 0; max-width: 68ch; color: var(--color-muted-on-dark); line-height: 1.6; }
        .sales-oracle-tool__status { margin: 0; padding: .85rem var(--space-lg); border-block-end: var(--rule-hair) solid var(--color-rule); background: #f8fafc; color: var(--color-ink-2); font-size: var(--text-sm); }
        .sales-oracle-tool__status[data-tone="success"] { background: #ecfdf5; color: #047857; }
        .sales-oracle-tool__status[data-tone="error"] { background: #fff1f2; color: #be123c; }
        .sales-oracle-tool__grid { display: grid; }
        .sales-oracle-tool__panel { min-width: 0; padding: var(--space-lg); border-block-end: var(--rule-hair) solid var(--color-rule); }
        .sales-oracle-tool__step { display: flex; align-items: center; gap: var(--space-xs); margin-block-end: var(--space-xs); color: var(--color-accent-strong); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
        .sales-oracle-tool__panel h4 { margin: 0 0 var(--space-xs); font-family: var(--font-display); font-size: var(--text-lg); }
        .sales-oracle-tool__panel > p { margin: 0 0 var(--space-md); color: var(--color-ink-2); font-size: var(--text-sm); line-height: 1.55; }
        .sales-oracle-tool__form, .sales-oracle-tool__fields { display: grid; gap: var(--space-sm); margin: 0; padding: 0; border: 0; }
        .sales-oracle-tool__field { display: grid; gap: .35rem; min-width: 0; color: var(--color-ink); font-size: var(--text-sm); font-weight: 650; }
        .sales-oracle-tool__field input, .sales-oracle-tool__field select, .sales-oracle-tool__field textarea { width: 100%; min-height: 2.8rem; padding: .7rem .8rem; border: var(--rule-hair) solid #cbd5e1; border-radius: .75rem; background: #fff; color: var(--color-ink); font: inherit; font-weight: 400; }
        .sales-oracle-tool__field textarea { min-height: 6.5rem; resize: vertical; line-height: 1.45; }
        .sales-oracle-tool__field input:focus-visible, .sales-oracle-tool__field select:focus-visible, .sales-oracle-tool__field textarea:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; border-color: transparent; }
        .sales-oracle-tool__button { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 2.9rem; padding-inline: 1rem; border: 0; border-radius: .75rem; background: var(--color-ink-deep); color: #fff; font-weight: 700; cursor: pointer; }
        .sales-oracle-tool__button:hover { background: #1e293b; }
        .sales-oracle-tool__button:disabled { cursor: wait; opacity: .6; }
        .sales-oracle-tool__button--secondary { border: var(--rule-hair) solid #cbd5e1; background: #fff; color: var(--color-ink); }
        .sales-oracle-tool__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs); }
        .sales-oracle-tool__link { color: var(--color-accent-strong); font-size: var(--text-sm); font-weight: 700; }
        .sales-oracle-tool__privacy { margin: var(--space-sm) 0 0; color: var(--color-ink-2); font-size: var(--text-xs); line-height: 1.5; }
        .sales-oracle-tool__documents { margin: 0; padding: var(--space-md) var(--space-lg); list-style: none; background: #f8fafc; }
        .sales-oracle-tool__document, .sales-oracle-tool__empty { display: flex; justify-content: space-between; gap: var(--space-sm); padding-block: .65rem; border-block-end: var(--rule-hair) solid #e2e8f0; color: var(--color-ink-2); font-size: var(--text-sm); overflow-wrap: anywhere; }
        .sales-oracle-tool__document:last-child, .sales-oracle-tool__empty:last-child { border-block-end: 0; }
        .sales-oracle-tool__document-state { flex: 0 0 auto; color: #047857; font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; }
        .sales-oracle__cta[aria-disabled="true"] { opacity: .55; cursor: not-allowed; pointer-events: none; transform: none; }
        @media (min-width: 40rem) { .sales-oracle__inner { padding-inline: var(--space-lg); } }
        @media (min-width: 60rem) { .sales-oracle__head { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); } .sales-oracle__overview { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); } .sales-oracle__outputs { grid-column: 1 / -1; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); } .sales-oracle__output-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } .sales-oracle-tool__header { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); align-items: end; } .sales-oracle-tool__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .sales-oracle-tool__panel { border-inline-end: var(--rule-hair) solid var(--color-rule); } .sales-oracle-tool__panel:last-child { border-inline-end: 0; } }
        @media (prefers-reduced-motion: reduce) { .sales-oracle__cta, .sales-oracle__workspace summary i { transition-duration: 150ms; } .sales-oracle__cta:hover { transform: none; } }
    </style>
</head>
