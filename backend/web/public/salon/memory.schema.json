{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.kayroslab.com/salon/memory.schema.json",
  "title": "SalonContextV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "self", "table", "open"],
  "properties": {
    "v": { "const": 3 },
    "speaker": { "type": ["string", "null"], "maxLength": 40, "pattern": "^[a-z0-9_]+$" },
    "anchor": { "type": ["string", "null"], "maxLength": 160 },
    "host": { "type": ["string", "null"], "maxLength": 160 },
    "self": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "recent"],
      "properties": {
        "digest": { "type": ["string", "null"], "maxLength": 280 },
        "recent": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "claim"],
            "properties": {
              "role": { "type": "string", "maxLength": 40 },
              "claim": { "type": "string", "maxLength": 140 }
            }
          }
        }
      }
    },
    "table": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim"],
        "properties": {
          "id": { "type": "string", "maxLength": 40, "pattern": "^[a-z0-9_]+$" },
          "role": { "type": "string", "maxLength": 40 },
          "claim": { "type": "string", "maxLength": 140 }
        }
      }
    },
    "open": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "maxLength": 90 }
    }
  }
}
