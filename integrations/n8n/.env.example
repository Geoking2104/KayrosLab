# Copier en `.env` (jamais commité) puis remplir. Fichier lu par docker-compose.yml.

# Domaine public de n8n (enregistrement DNS A → 51.210.9.71).
N8N_DOMAIN=n8n.kayroslab.com

# Clé de chiffrement des identifiants n8n (Salesforce, clé KayrosLab, secret HMAC).
# À générer UNE fois et à sauvegarder : la perdre rend les identifiants illisibles.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Base de données : Postgres local (recommandé) ou `sqlite` (aucun prérequis).
DB_TYPE=postgresdb
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
# Même mot de passe que dans init-n8n-db.sql.  openssl rand -base64 24
N8N_DB_PASSWORD=
